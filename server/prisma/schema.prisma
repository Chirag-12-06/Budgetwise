generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  Int                @id @default(autoincrement())
  name                String
  email               String             @unique
  password            String
  avatarDataUrl       String?
  createdAt           DateTime           @default(now())
  passwordResetExpiry DateTime?
  passwordResetToken  String?
  expenses            Expense[]
  recurringExpenses   RecurringExpense[]
}

model Expense {
  id          Int               @id @default(autoincrement())
  title       String
  amount      Float
  category    String
  createdAt   DateTime          @default(now())
  userId      Int?
  recurringId Int?
  recurring   RecurringExpense? @relation(fields: [recurringId], references: [id], onDelete: Cascade)
  user        User?             @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([recurringId])
}

model RecurringExpense {
  id              Int                 @id(map: "recurring_expenses_pkey") @default(autoincrement())
  title           String
  userId          Int                 @map("user_id")
  amount          Float
  category        String
  frequency       RecurrenceFrequency
  intervalValue   Int                 @default(1) @map("interval_value")
  startDate       DateTime            @map("start_date")
  endType         RecurrenceEndType   @map("end_type")
  endCount        Int?                @map("end_count")
  endDate         DateTime?           @map("end_date")
  occurrencesDone Int                 @default(0) @map("occurrences_done")
  nextDueDate     DateTime            @map("next_due_date")
  isActive        Boolean             @default(true) @map("is_active")
  expenses        Expense[]
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade, map: "recurring_expenses_user_id_fkey")

  @@index([nextDueDate], map: "recurring_expenses_next_due_date_idx")
  @@index([userId, isActive], map: "recurring_expenses_user_id_is_active_idx")
}

enum RecurrenceFrequency {
  DAILY   @map("daily")
  WEEKLY  @map("weekly")
  MONTHLY @map("monthly")
  YEARLY  @map("yearly")
}

enum RecurrenceEndType {
  FOREVER    @map("forever")
  COUNT      @map("count")
  UNTIL_DATE @map("until_date")
}
