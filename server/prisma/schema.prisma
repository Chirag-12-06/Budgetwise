// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  //output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique
  password  String
  avatarDataUrl String?
  createdAt DateTime  @default(now())
  expenses  Expense[]
}

model Expense {
  id                 Int       @id @default(autoincrement())
  title              String
  amount             Float
  category           String
  createdAt          DateTime  @default(now())
  recurrenceFrequency String?
  recurrenceEndDate  DateTime?
  nextRecurrenceDate DateTime?
  recurrenceWeeklyDays String?
  recurrenceDuration String?
  recurrenceCount    String?
  recurrenceMonthlyPattern String?
  recurrenceYearlyPattern String?
  isRecurringTemplate Boolean  @default(false)
  recurringParentId  Int?
  recurringParent    Expense?  @relation("RecurringExpense", fields: [recurringParentId], references: [id], onDelete: SetNull)
  recurringChildren  Expense[] @relation("RecurringExpense")
  userId             Int?
  user               User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([recurringParentId, createdAt])
  @@unique([recurringParentId, createdAt])
}
