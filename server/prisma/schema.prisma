// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  //output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique
  password  String
  avatarDataUrl String?
  createdAt DateTime  @default(now())
  expenses  Expense[]
  recurringExpenses RecurringExpense[]
}

model Expense {
  id        Int      @id @default(autoincrement())
  title     String
  amount    Float
  category  String
  createdAt DateTime @default(now())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  recurringId  Int?
  recurring    RecurringExpense? @relation(fields: [recurringId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([recurringId])
}

enum RecurrenceFrequency {
  DAILY   @map("daily")
  WEEKLY  @map("weekly")
  MONTHLY @map("monthly")
  YEARLY  @map("yearly")
}

enum RecurrenceEndType {
  FOREVER    @map("forever")
  COUNT      @map("count")
  UNTIL_DATE @map("until_date")
}

model RecurringExpense {
  id              Int                 @id @default(autoincrement())
  title           String
  userId          Int                 @map("user_id")
  amount          Float
  category        String
  frequency       RecurrenceFrequency
  intervalValue   Int                 @default(1) @map("interval_value")
  startDate       DateTime            @map("start_date")
  endType         RecurrenceEndType   @map("end_type")
  endCount        Int?                @map("end_count")
  endDate         DateTime?           @map("end_date")
  occurrencesDone Int                 @default(0) @map("occurrences_done")
  nextDueDate     DateTime            @map("next_due_date")
  isActive        Boolean             @default(true) @map("is_active")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@index([userId, isActive])
  @@index([nextDueDate])
  @@map("recurring_expenses")
}
