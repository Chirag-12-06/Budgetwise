DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME?schema=budgetwise_app
JWT_SECRET=replace-with-strong-random-secret
JWT_EXPIRES_IN=7d
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
SESSION_IDLE_MINUTES=15

# OpenAI (used by ml-service/OCR/expense_extractor.py)
# Set this in server/.env so Node passes it to the spawned ML service.
OPENAI_API_KEY=
# Optional overrides
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_RETRIES=3

ML_PORT=5001
PYTHON_EXECUTABLE=python3
CORS_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:4173
PORT=5000
